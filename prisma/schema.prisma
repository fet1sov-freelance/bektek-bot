generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Application {
  id Int @id @default(autoincrement())
  createdAt DateTime @default(now())
  fio String
  email String
  phone String
  type String
  status String
}